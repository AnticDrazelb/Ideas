[application]

config/name="SINGULARITY ENGINE"
config/description="You are a black hole inside a broken machine. Fold the engine until its circuits align, then collapse into the core."
run/main_scene="res://game/Main.tscn"
config/icon="res://assets/icon.png"

[display]

window/size/width=405
window/size/height=720
window/handheld/orientation="sensor"

[input]

ui_cancel={
"deadzone": 0.5,
"events": [ Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"alt":false,"shift":false,"control":false,"meta":false,"command":false,"pressed":false,"scancode":16777217,"physical_scancode":0,"unicode":0,"echo":false,"script":null)
 ]
}

[physics]

common/enable_pause_aware_picking=true

[rendering]

quality/driver/driver_name="GLES2"
quality/intended_usage/framebuffer_allocation.mobile=2
threads/thread_model=2
vram_compression/import_etc=true
vram_compression/import_etc2=false
environment/default_clear_color=Color( 0.043137, 0.043137, 0.054902, 1 )
quality/2d/use_pixel_snap=false
