[application]

config/name="SINGULARITY ENGINE"
config/description="You are a black hole inside a broken machine. Fold the engine until its circuits align, then collapse into the core."
run/main_scene="res://game/Main.tscn"
config/icon="res://assets/icon.png"

; NO AUTOLOADS, and that is a decision rather than an omission.
;
; The C# project is built out of static classes — Store, Access, Palette,
; Layout, Coach and a dozen more — and the natural Godot translation is an
; autoload apiece. It is the wrong one here for a reason that only shows up
; headless: an autoload's name is a global identifier registered when a SceneTree
; is the main loop, and `godot -s tests/run.gd` replaces the main loop, so every
; one of those names becomes a parse error and the whole harness stops existing.
;
; So the statics stay static. GDScript 3.5 has static functions and no static
; variables, and a `const` Array or Dictionary is a single object owned by the
; script whose CONTENTS are mutable — which is exactly the storage a C# static
; field provides. See the note in core/Turns.gd.

[display]

window/size/width=1080
window/size/height=1920
window/size/test_width=405
window/size/test_height=720
window/handheld/orientation="sensor"
window/stretch/mode="2d"
window/stretch/aspect="expand"

[input]

ui_cancel={
"deadzone": 0.5,
"events": [ Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"alt":false,"shift":false,"control":false,"meta":false,"command":false,"pressed":false,"scancode":16777217,"physical_scancode":0,"unicode":0,"echo":false,"script":null)
 ]
}

[physics]

common/enable_pause_aware_picking=true

[rendering]

quality/driver/driver_name="GLES2"
quality/intended_usage/framebuffer_allocation.mobile=2
threads/thread_model=2
vram_compression/import_etc=true
vram_compression/import_etc2=false
environment/default_clear_color=Color( 0.043137, 0.043137, 0.054902, 1 )
quality/2d/use_pixel_snap=false
