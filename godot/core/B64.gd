class_name B64
# THE BASE64URL ALPHABET, in a file of its own.
#
# Both the share code and the eight-character identity are written in it, and
# for a while it lived on Identity — which meant ShareCode named Identity,
# Identity named Catalogue to ask what already exists, and Catalogue named
# ShareCode to decode a cube. Godot refuses that ring at load time and all three
# classes fail together, with an error that names none of the three.
#
# A constant that two things share belongs to neither of them.
const A := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
