<resources>
    <!-- ============================================================
         THE BOARD MAP — the page's half of a deliberate split.

         The HTML never learns a Google leaderboard id. It submits to logical
         names it makes up itself (`vault_07`, `daily_streak`) and this file
         owns the mapping to the opaque strings the Play Console assigns. Board
         ids can be reissued and re-pointed here without touching the game.

         FORMAT: logical=CgkI...  — one per entry, no spaces around the '='.
         An entry whose right-hand side is still a placeholder is skipped at
         runtime, so a half-configured map submits the boards you have set up
         and silently drops the rest rather than throwing.

         The logical names are fixed by the page:
           daily, daily_week, daily_month, daily_season, daily_streak
           vault_01 .. vault_30   (RANKED_VAULTS = 30 in the page)
         ============================================================ -->
    <string-array name="leaderboard_map" translatable="false">
        <item>daily=CHANGE_ME</item>
        <item>daily_week=CHANGE_ME</item>
        <item>daily_month=CHANGE_ME</item>
        <item>daily_season=CHANGE_ME</item>
        <item>daily_streak=CHANGE_ME</item>

