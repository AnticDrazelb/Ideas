<?xml version="1.0" encoding="utf-8"?>
<!-- Android 13+ themed icons. The launcher tints this single-colour silhouette
     to the user's wallpaper palette; an app that omits it is the one icon on
     the home screen that stays loud when everything else goes quiet. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M32,32 h44 v44 h-44 z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.5"
        android:fillColor="#00000000" />

    <path
        android:pathData="M54,54 m-13,0 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4" />
</vector>
