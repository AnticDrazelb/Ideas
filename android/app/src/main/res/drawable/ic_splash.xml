<?xml version="1.0" encoding="utf-8"?>
<!-- The splash icon. The SplashScreen API draws this inside a 108dp window and
     masks it to a circle of 2/3 that, so the art is kept well inside — the
     frame reads as a frame rather than as four clipped corners.

     No background layer is set on the splash style, which means this sits
     directly on the same black the window and the page use. There is no disc
     behind it and therefore no edge to catch the eye when it lifts. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M35,35 h38 v38 h-38 z"
        android:strokeColor="#EA580C"
        android:strokeWidth="3"
        android:fillColor="#00000000" />

    <path
        android:pathData="M54,54 m-11,0 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0"
        android:fillColor="#000000"
        android:strokeColor="#22D3EE"
        android:strokeWidth="3.5" />
</vector>
